  "components": {
    "schemas": {
      "AddFamilyMemberCommand": {
        "required": [
          "profileInfo",
          "treeId"
        ],
        "type": "object",
        "properties": {
          "treeId": {
            "type": "string",
            "format": "uuid"
          },
          "claimedByUserId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "profileInfo": {
            "$ref": "#/components/schemas/ProfileInfo"
          },
          "visibilityStatus": {
            "$ref": "#/components/schemas/VisibilityStatus"
          }
        },
        "additionalProperties": false
      },
      "AddRelationshipCommand": {
        "required": [
          "baseFamilyMemberId",
          "relatedFamilyMemberId",
          "relationshipType",
          "treeId"
        ],
        "type": "object",
        "properties": {
          "treeId": {
            "type": "string",
            "format": "uuid"
          },
          "baseFamilyMemberId": {
            "type": "string",
            "format": "uuid"
          },
          "relatedFamilyMemberId": {
            "type": "string",
            "format": "uuid"
          },
          "relationshipType": {
            "$ref": "#/components/schemas/RelationshipType"
          }
        },
        "additionalProperties": false
      },
      "AddTreeAccessCommand": {
        "required": [
          "accessLevel",
          "treeId",
          "userId"
        ],
        "type": "object",
        "properties": {
          "treeId": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "accessLevel": {
            "$ref": "#/components/schemas/TreeRole"
          }
        },
        "additionalProperties": false
      },
      "AddTreeEdgeCommand": {
        "required": [
          "sourceNodeId",
          "targetNodeId",
          "treeId"
        ],
        "type": "object",
        "properties": {
          "treeId": {
            "type": "string",
            "format": "uuid"
          },
          "sourceNodeId": {
            "type": "string",
            "format": "uuid"
          },
          "targetNodeId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "AddTreeNodeCommand": {
        "required": [
          "nodeType",
          "treeId",
          "x",
          "y"
        ],
        "type": "object",
        "properties": {
          "treeId": {
            "type": "string",
            "format": "uuid"
          },
          "nodeType": {
            "$ref": "#/components/schemas/NodeType"
          },
          "x": {
            "type": "number",
            "format": "double"
          },
          "y": {
            "type": "number",
            "format": "double"
          },
          "familyMemberIds": {
            "type": "array",
            "items": {
              "type": "string",
